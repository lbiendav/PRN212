<UserControl x:Class="ExamManagementSystem.Presentation.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- Khu vực tổng kết hiển thị điểm nổi bật và các nút điều hướng. -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="34,22">
            <Grid>
                <StackPanel><TextBlock Text="Kết quả bài thi" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding ExamTitle}" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScoreText}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,25,0" />
                    <Button Content="Về trang chủ" Command="{Binding GoHomeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0" />
                    <Button Content="Thi lại" Command="{Binding RetakeCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mỗi thẻ đáp án đổi màu theo IsCorrect bằng DataTrigger. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,22">
            <ItemsControl ItemsSource="{Binding Answers}" Width="850" HorizontalAlignment="Center">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Margin="0,0,0,14" Padding="20" CornerRadius="11" BorderThickness="1">
                        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Setter Property="Background" Value="#FFF3F3" /><Setter Property="BorderBrush" Value="#F2B8B8" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsCorrect}" Value="True"><Setter Property="Background" Value="#EDFAF4" /><Setter Property="BorderBrush" Value="#A7DFC9" /></DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="Câu " /><Run Text="{Binding OrderNumber}" /><Run Text=": " /><Run Text="{Binding QuestionContent}" /></TextBlock>
                                <TextBlock Margin="0,12,0,4" TextWrapping="Wrap"><Run Text="Bạn chọn: " FontWeight="SemiBold" /><Run Text="{Binding SelectedAnswer}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap"><Run Text="Đáp án đúng: " FontWeight="SemiBold" /><Run Text="{Binding CorrectAnswer}" /></TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ResultText}" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="Bold">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsCorrect}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
