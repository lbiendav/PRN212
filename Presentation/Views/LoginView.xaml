<UserControl x:Class="ExamManagementSystem.Presentation.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:ExamManagementSystem.Presentation.MVVM">
    <!-- Nền hai cột giúp form rõ ràng và giới thiệu ngắn mục đích ứng dụng. -->
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <!-- Khu vực nhận diện sản phẩm. -->
        <Border Margin="52" CornerRadius="24" Background="#E9E8FF" Padding="50">
            <StackPanel VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="✓" Foreground="White" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ExamFlow" FontSize="42" FontWeight="Bold" Margin="0,24,0,12" />
                <TextBlock Text="Học, thi và xem lại kết quả trong một trải nghiệm đơn giản."
                           FontSize="19" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="430" HorizontalAlignment="Left" />
                <TextBlock Text="• Làm bài trắc nghiệm có giới hạn thời gian&#10;• Chấm điểm và lưu lịch sử tự động&#10;• Xem từng đáp án đúng, sai và thi lại"
                           FontSize="16" LineHeight="32" Margin="0,28,0,0" />
            </StackPanel>
        </Border>

        <!-- Form đăng nhập Binding trực tiếp vào LoginViewModel. -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="430" Padding="38" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Đăng nhập" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Nhập tài khoản để tiếp tục học tập." Style="{StaticResource MutedTextStyle}" Margin="0,0,0,28" />

                <TextBlock Text="Tên đăng nhập" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="Mật khẩu" Style="{StaticResource LabelStyle}" />
                <PasswordBox mvvm:PasswordBoxAssistant.Attach="True"
                             mvvm:PasswordBoxAssistant.Password="{Binding Password, Mode=TwoWay}"
                             Margin="0,0,0,10" />

                <!-- Message hiển thị lỗi validation từ tầng Business. -->
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,2,0,14" />
                <Button Content="Đăng nhập" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <TextBlock Text="Chưa có tài khoản?" VerticalAlignment="Center" />
                    <Button Content="Đăng ký ngay" Command="{Binding ShowRegisterCommand}" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" Margin="6,0,0,0" />
                </StackPanel>
                <Border Background="#F5F5FF" CornerRadius="8" Padding="12" Margin="0,24,0,0">
                    <TextBlock Text="Tài khoản mẫu: admin / Admin@123 hoặc student / Student@123" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
