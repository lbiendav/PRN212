<UserControl x:Class="ExamManagementSystem.Presentation.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- Thanh đầu trang hiển thị người dùng hiện tại và nút đăng xuất. -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,18">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="✓" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0"><TextBlock Text="ExamFlow" FontSize="19" FontWeight="Bold" /><TextBlock Text="Học viên" Style="{StaticResource MutedTextStyle}" FontSize="12" /></StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding WelcomeText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <Button Content="Đăng xuất" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- TabControl tách rõ kho đề và lịch sử nhưng vẫn cùng nằm trong trang chủ. -->
        <TabControl Grid.Row="1" Margin="32" Background="Transparent" BorderThickness="0">
            <TabItem Header="ĐỀ THI ĐANG MỞ">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                    <!-- Tiêu đề và vùng tìm kiếm đề. -->
                    <Grid Margin="0,0,0,18">
                        <StackPanel><TextBlock Text="Chọn đề để bắt đầu" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Điểm và câu trả lời sẽ được lưu ngay khi bạn nộp bài." Style="{StaticResource MutedTextStyle}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBox Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm theo tên đề, môn hoặc mô tả" />
                            <Button Content="Tìm kiếm" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" />
                            <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Mỗi đề được trình bày dạng thẻ, ItemsControl tự tạo từ collection Exams. -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Exams}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Width="340" MinHeight="220" Margin="0,0,18,18">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Border Background="#EEEDFF" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left"><TextBlock Text="{Binding Subject}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12" /></Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,13,0,7" />
                                            <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                            <Grid Grid.Row="3" Margin="0,18,0,0">
                                                <TextBlock VerticalAlignment="Center"><Run Text="{Binding QuestionCount}" /><Run Text=" câu  •  " /><Run Text="{Binding DurationMinutes}" /><Run Text=" phút" /></TextBlock>
                                                <Button Content="Làm bài →" Command="{Binding DataContext.StartExamCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="LỊCH SỬ LÀM BÀI">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18"><TextBlock Text="Kết quả của bạn" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Xem lại đáp án hoặc bắt đầu một lượt thi mới." Style="{StaticResource MutedTextStyle}" /></StackPanel>

                    <!-- DataGrid hiển thị mỗi lần thi, không gộp để người dùng theo dõi sự tiến bộ. -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Môn" Binding="{Binding Subject}" Width="130" />
                            <DataGridTextColumn Header="Đề thi" Binding="{Binding ExamTitle}" Width="*" />
                            <DataGridTextColumn Header="Điểm" Binding="{Binding Score, StringFormat={}{0:0.##}/10}" Width="100" />
                            <DataGridTextColumn Header="Số câu đúng" Binding="{Binding CorrectText}" Width="110" />
                            <DataGridTextColumn Header="Ngày làm" Binding="{Binding SubmittedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150" />
                            <DataGridTemplateColumn Header="Thao tác" Width="210">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Content="Xem đáp án" Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,3,6,3" />
                                    <Button Content="Thi lại" Command="{Binding DataContext.RetakeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,3" />
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
