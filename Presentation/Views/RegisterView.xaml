<UserControl x:Class="ExamManagementSystem.Presentation.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:ExamManagementSystem.Presentation.MVVM">
    <!-- ScrollViewer bảo đảm form vẫn dùng được khi chiều cao cửa sổ nhỏ. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource PageBackgroundBrush}">
        <Border Style="{StaticResource CardStyle}" Width="500" Padding="38" Margin="30" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Tạo tài khoản học viên" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Điền đủ thông tin bên dưới để bắt đầu làm bài." Style="{StaticResource MutedTextStyle}" Margin="0,0,0,24" />

                <!-- Các ô TextBox Binding TwoWay mặc định khi mất focus. -->
                <TextBlock Text="Tên đăng nhập" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13" />
                <TextBlock Text="Họ và tên" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13" />
                <TextBlock Text="Email" Style="{StaticResource LabelStyle}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13" />

                <!-- PasswordBox dùng attached behavior để vẫn tuân theo MVVM. -->
                <TextBlock Text="Mật khẩu (ít nhất 6 ký tự)" Style="{StaticResource LabelStyle}" />
                <PasswordBox mvvm:PasswordBoxAssistant.Attach="True" mvvm:PasswordBoxAssistant.Password="{Binding Password, Mode=TwoWay}" Margin="0,0,0,13" />
                <TextBlock Text="Xác nhận mật khẩu" Style="{StaticResource LabelStyle}" />
                <PasswordBox mvvm:PasswordBoxAssistant.Attach="True" mvvm:PasswordBoxAssistant.Password="{Binding ConfirmPassword, Mode=TwoWay}" Margin="0,0,0,8" />

                <!-- Thông báo validation và hai hành động chính của form. -->
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,3,0,14" />
                <Button Content="Đăng ký" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" />
                <Button Content="← Quay lại đăng nhập" Command="{Binding ShowLoginCommand}" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource PrimaryBrush}" Cursor="Hand" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
